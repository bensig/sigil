node_modules/
dist/
.vite/
*.log
.DS_Store

# Private wallet configs — never commit real xpubs/labels/recipients.
# The example/ config is the only tracked wallet.
# No trailing slash: symlinked config dirs (used to overlay private configs)
# are not matched by git's directory-only gitignore patterns.
src/configs/*
!src/configs/example/
src/data/*
